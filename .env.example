# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never in client code

# Gemini AI Vision Diagnosis (Set USE_LIVE_GEMINI=true to use real Google Gemini API)
USE_LIVE_GEMINI=true
GEMINI_API_KEY=                   # from Google AI Studio (https://aistudio.google.com)
GEMINI_MODEL=gemini-1.5-flash

# Mandi Agmarknet Prices (Set USE_LIVE_MANDI_API=true to use real data.gov.in Agmarknet API)
USE_LIVE_MANDI_API=true
DATA_GOV_API_KEY=                 # from data.gov.in (https://data.gov.in)
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Village Outbreak Detection Parameters
OUTBREAK_RADIUS_M=5000
OUTBREAK_WINDOW_DAYS=7
OUTBREAK_MIN_FARMERS=3

# Sarpanch AI Copilot (Groq Llama 3.3 70B - Free key from https://console.groq.com)
# If left blank or if rate-limited, automatically falls back to built-in pre-trained agronomy engine
GROQ_API_KEY=
